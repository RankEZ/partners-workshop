FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# sshd (so it's a Linux device rankEZ can SSH into) + Python for the login-form app
RUN apt-get update && apt-get install -y --no-install-recommends \
      openssh-server sudo curl ca-certificates python3 python3-pip && \
    rm -rf /var/lib/apt/lists/* && \
    pip3 install --no-cache-dir flask pymysql

RUN ssh-keygen -A

# Accounts: super (sudo -> root, the CPM-for-File handle account) and oper (low-priv)
RUN useradd -m -s /bin/bash super && \
    echo 'super:RankEZ123!' | chpasswd && \
    echo 'super ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers && \
    useradd -m -s /bin/bash oper && \
    echo 'oper:RankEZ123!' | chpasswd && \
    echo 'root:RankEZ123!' | chpasswd

RUN sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config

WORKDIR /app
COPY web-app/app.py /app/app.py
COPY entrypoint-web.sh /entrypoint-web.sh
RUN chmod +x /entrypoint-web.sh

EXPOSE 22 80

ENTRYPOINT ["/entrypoint-web.sh"]